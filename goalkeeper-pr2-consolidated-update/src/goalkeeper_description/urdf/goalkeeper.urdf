      <origin xyz="0.00169047619 0 0.150952381" rpy="0 0 0" />
      <mass value="42" />
      <inertia ixx="3.051995238" iyy="2.265774548" izz="4.86092931" ixy="0" ixz="-0.02407238095" iyz="0" />
