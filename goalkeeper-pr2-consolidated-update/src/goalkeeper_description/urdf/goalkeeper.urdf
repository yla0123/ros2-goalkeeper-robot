<?xml version='1.0' encoding='utf-8'?>
<robot name="goalkeeper_robot">
  <!--Generated from config/keeper.design.json; run tools/generate_geometry.py.-->
  <link name="world" />
  <link name="base_link">
    <inertial>
      <mass value="0.001" />
      <inertia ixx="1e-06" iyy="1e-06" izz="1e-06" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="world_to_base" type="fixed">
    <parent link="world" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="keeper_chassis">
